---
import Navbar from '../components/Navbar.astro'
import PageHeader from '../components/PageHeader.astro'
import ConventionOverview from '../components/convention/ConventionOverview.astro'
import ConventionStatus from '../components/convention/ConventionStatus.astro'
import ProcessCallout from '../components/process/ProcessCallout.astro'
import Footer from '../components/Footer.astro'
import '../styles/global.css'
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Hong Kong Convention | Rudra Green Ship Recycling Group</title>
  </head>
  <body class="bg-paper">
    <Navbar />
    <PageHeader
      eyebrow="Green Ship Recycling"
      title="The Hong Kong Convention."
      desc="The international framework governing safe and environmentally sound ship recycling — and the standard our Alang operations are built around."
      crumb="Hong Kong Convention"
      meta={[
        { label: 'Adopted', value: '2009' },
        { label: 'Governing body', value: 'IMO' },
        { label: 'Applies to', value: 'Ship Recycling' },
      ]}
    />
    <ConventionOverview />
    <ConventionStatus />
    <ProcessCallout />
    <Footer />
  </body>
</html>