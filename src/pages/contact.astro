---
import Navbar from '../components/Navbar.astro'
import PageHeader from '../components/PageHeader.astro'
import ContactChannels from '../components/contact/ContactChannels.astro'
import ContactForm from '../components/contact/ContactForm.astro'
import ContactInfo from '../components/contact/ContactInfo.astro'
import ContactMap from '../components/contact/ContactMap.astro'
import Footer from '../components/Footer.astro'
import '../styles/global.css'
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Contact Us | Rudra Green Ship Recycling Group</title>
  </head>
  <body class="bg-paper">
    <Navbar />
    <PageHeader
      eyebrow="Contact"
      title="Get in touch."
      desc="Whether it's a general inquiry, a ship recycling question, or a media request — reach out and we'll route it to the right team."
      crumb="Contact Us"
    />
    <ContactChannels />
    <section class="relative bg-paper py-4 lg:py-8 pb-16 lg:pb-20 overflow-hidden">
      <div class="max-w-[1800px] mx-auto px-6 sm:px-10 xl:px-16 2xl:px-20">
        <div class="grid lg:grid-cols-[1.3fr_0.9fr] gap-10 xl:gap-16">
          <ContactForm />
          <ContactInfo />
        </div>
      </div>
    </section>
    <ContactMap />
    <Footer />
  </body>
</html>