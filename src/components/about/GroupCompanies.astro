---
const verticals = [
  { name: 'Ship Recycling', tag: 'Alang, Gujarat', current: true },
  { name: 'Steel Recovery', tag: 'Induction Furnaces & Rolling Mills' },
  { name: 'TMT Bars', tag: 'Rudra TMX 550D' },
  { name: 'Construction Cement', tag: 'Building Materials' },
  { name: 'ACC Blocks', tag: 'Building Materials' },
  { name: 'Industrial Pipes', tag: 'Manufacturing' },
  { name: 'Renewable Energy', tag: 'Wind & Solar' },
]
---

<section class="relative bg-navy-950 py-24 lg:py-32 overflow-hidden">
  <div class="hidden xl:block absolute inset-0 opacity-[0.05] pointer-events-none"
    style="background-image: linear-gradient(#fff 1px, transparent 1px), linear-gradient(90deg, #fff 1px, transparent 1px); background-size: 64px 64px;">
  </div>
  <!-- soft radial glow, gives the dark section some atmosphere instead of flat navy -->
  <div class="absolute -top-40 -right-40 w-[600px] h-[600px] rounded-full bg-rust-500/[0.06] blur-3xl pointer-events-none"></div>

  <div class="relative max-w-[1800px] mx-auto px-6 sm:px-10 xl:px-16 2xl:px-20">
    <div class="flex items-end justify-between flex-wrap gap-6 mb-16 lg:mb-20">
      <div>
        <div class="flex items-center gap-3 mb-5">
          <span class="w-8 h-px bg-rust-500"></span>
          <p class="eyebrow text-stone-200">The Rudra Green Ship Recycling Limited</p>
        </div>
        <h2 class="font-display font-semibold text-3xl lg:text-4xl xl:text-5xl text-white max-w-xl leading-[1.1]">
          One group, five industrial verticals.
        </h2>
      </div>
      <p class="text-stone-300 text-sm max-w-xs">
        Rudra Green Ship Recycling Limited operates as part of a wider group built on the same
        steel-manufacturing origins.
      </p>
    </div>

    <div class="border-t border-white/15">
      {verticals.map((v, i) => (
        <div class="group relative flex items-center justify-between gap-6 py-8 border-b border-white/15 transition-colors duration-300 hover:bg-white/[0.04] px-3 -mx-3">

          <div class="flex items-center gap-5 xl:gap-8 min-w-0">
            <span class="font-mono text-xs text-white/40 shrink-0 w-6 transition-colors duration-300 group-hover:text-rust-400">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="font-display font-semibold text-2xl xl:text-3xl text-white truncate transition-colors duration-300 group-hover:text-rust-100">
              {v.name}
            </h3>
          </div>

          <div class="flex items-center gap-6 shrink-0">
            <span class="font-mono text-xs tracking-wide text-stone-300 hidden sm:block">{v.tag}</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" class="text-white/30 transition-all duration-300 group-hover:text-rust-400 group-hover:translate-x-1">
              <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>

          <!-- accent bar on hover, same motif as Strengths cards -->
          <span class="absolute left-0 bottom-0 h-0.5 w-0 bg-rust-500 transition-all duration-300 ease-out group-hover:w-full"></span>
        </div>
      ))}
    </div>
  </div>
</section>