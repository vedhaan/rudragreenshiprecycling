<section class="relative bg-paper overflow-hidden">
  <div class="hidden xl:block absolute inset-0 opacity-[0.035] pointer-events-none"
    style="background-image: linear-gradient(#0E2142 1px, transparent 1px), linear-gradient(90deg, #0E2142 1px, transparent 1px); background-size: 64px 64px;">
  </div>

  <div class="relative max-w-[1800px] mx-auto px-6 sm:px-10 xl:px-16 2xl:px-20 pt-10 lg:pt-14">
    <div class="flex items-center gap-2 mb-12 lg:mb-16 text-xs font-mono text-stone-500">
      <a href="/" class="hover:text-rust-600 transition-colors">Home</a>
      <span>/</span>
      <span class="text-navy-900">About Rudra</span>
    </div>
  </div>

  <div class="relative max-w-[1800px] mx-auto px-6 sm:px-10 xl:px-16 2xl:px-20 grid lg:grid-cols-[1.05fr_0.95fr] gap-16 xl:gap-20 items-center pb-20 lg:pb-28">

    <!-- TEXT -->
    <div class="hero-fade" style="animation-delay:0ms">
      <div class="flex items-center gap-3 mb-6">
        <span class="w-8 h-px bg-rust-500"></span>
        <p class="eyebrow text-rust-500">Bhavnagar, Gujarat · Since 1991</p>
      </div>

      <h1 class="font-display font-medium text-navy-950 text-[2.5rem] sm:text-5xl lg:text-6xl xl:text-[4.2rem] leading-[1.05] tracking-tight break-words">
        <span class="block">Three decades of building,</span>
        <span class="block italic text-rust-500">responsibly.</span>
      </h1>

      <p class="mt-8 text-stone-600 text-base lg:text-lg leading-relaxed max-w-lg">
        Rudra Green Ship Recycling Group is a subsidiary of Rudra Global — a diversified
        industrial group operating out of Bhavnagar, Gujarat, with roots in steel
        manufacturing and a footprint that now spans ship recycling, cement, and
        industrial materials.
      </p>

      <div class="mt-10 flex flex-wrap items-center gap-8">
        <div class="flex gap-4">
          <a href="#story" class="bg-rust-500 text-white px-7 py-3.5 font-medium hover:bg-rust-600 transition-colors">
            Our Story
          </a>
          <a href="/investor-relations" class="border border-navy-900 text-navy-900 px-7 py-3.5 font-medium hover:bg-navy-900 hover:text-white transition-colors">
            Investor Relations
          </a>
        </div>
        <div class="flex items-baseline gap-2 pl-8 border-l border-stone-300">
          <span class="font-display font-semibold text-3xl text-navy-950">5</span>
          <span class="eyebrow text-stone-500">Group<br/>Verticals</span>
        </div>
      </div>
    </div>

    <!-- ILLUSTRATION: hull cut → plate lifted by crane → cascading segments → scrap -->
   <div class="hero-fade min-w-0 overflow-hidden" style="animation-delay:180ms">
      <div class="relative bg-white border border-stone-300 p-4 sm:p-6 overflow-hidden min-w-0">
        <span class="absolute top-2.5 left-2.5 w-4 h-4 border-t-2 border-l-2 border-stone-300"></span>
        <span class="absolute top-2.5 right-2.5 w-4 h-4 border-t-2 border-r-2 border-stone-300"></span>
        <span class="absolute bottom-2.5 left-2.5 w-4 h-4 border-b-2 border-l-2 border-stone-300"></span>
        <span class="absolute bottom-2.5 right-2.5 w-4 h-4 border-b-2 border-r-2 border-stone-300"></span>

        <svg viewBox="0 0 640 560" class="w-full h-auto" role="img" aria-label="Illustration of a crane lifting a cut steel plate from a ship's hull, with further sectioned plates cascading toward processing">

          <!-- ground -->
          <line x1="30" y1="480" x2="610" y2="480" stroke="#B8B6AE" stroke-width="1.5" stroke-dasharray="2 6" />

          <!-- crane -->
          <rect x="528" y="28" width="64" height="10" fill="#0E2142" />
          <line x1="560" y1="38" x2="560" y2="470" stroke="#0E2142" stroke-width="3" />
          <line x1="560" y1="58" x2="326" y2="104" stroke="#0E2142" stroke-width="3" />

          <!-- lift group: hook + plate 01, animated together -->
          <g class="lift-group">
            <line x1="326" y1="104" x2="332" y2="222" stroke="#0E2142" stroke-width="1.5" stroke-dasharray="3 5" opacity="0.55" />
            <circle cx="332" cy="222" r="4" fill="#E67A22" />

            <g transform="rotate(-6 332 265)">
              <rect x="300" y="205" width="64" height="120" fill="#1E3A6B" />
              <rect x="300" y="205" width="64" height="120" fill="none" stroke="#E67A22" stroke-width="1.5" stroke-dasharray="3 3" />
              <rect x="308" y="213" width="26" height="16" fill="#F4F4F1" />
              <text x="313" y="225" font-family="JetBrains Mono, monospace" font-size="11" fill="#0E2142">01</text>
            </g>
          </g>

          <!-- hull -->
          <path d="M40,480 L40,380 L90,335 L262,335 L262,480 Z" fill="#0E2142" />
          <!-- torn cut face -->
          <path d="M262,335 L253,355 L262,373 L251,395 L262,413 L253,433 L262,451 L251,470 L262,480"
            fill="none" stroke="#F4F4F1" stroke-width="2" />

          <!-- bridge superstructure -->
          <rect x="128" y="298" width="62" height="37" fill="#0E2142" />
          <rect x="141" y="307" width="9" height="11" fill="#4C7A5D" opacity="0.7" />
          <rect x="158" y="307" width="9" height="11" fill="#4C7A5D" opacity="0.7" />
          <rect x="167" y="276" width="13" height="23" fill="#E67A22" />

          <!-- portholes -->
          <circle cx="65" cy="430" r="4.5" fill="#F4F4F1" opacity="0.5" />
          <circle cx="88" cy="430" r="4.5" fill="#F4F4F1" opacity="0.5" />
          <circle cx="111" cy="430" r="4.5" fill="#F4F4F1" opacity="0.5" />
          <circle cx="134" cy="430" r="4.5" fill="#F4F4F1" opacity="0.5" />
          <circle cx="157" cy="430" r="4.5" fill="#F4F4F1" opacity="0.5" />

          <!-- label near cut face -->
          <text x="278" y="352" font-family="JetBrains Mono, monospace" font-size="11" letter-spacing="1.5" fill="#D06515">SECTION CUT</text>

          <!-- cutlines to lower segments -->
          <line x1="262" y1="395" x2="300" y2="395" stroke="#E67A22" stroke-width="1.5" stroke-dasharray="4 4" class="cutline" />
          <line x1="262" y1="430" x2="378" y2="440" stroke="#E67A22" stroke-width="1.5" stroke-dasharray="4 4" class="cutline" style="animation-delay:.3s" />
          <line x1="262" y1="460" x2="452" y2="470" stroke="#E67A22" stroke-width="1.5" stroke-dasharray="4 4" class="cutline" style="animation-delay:.6s" />

          <!-- segment 02: still near hull, freshly cut -->
          <g class="segment" style="animation-delay:0ms">
            <rect x="300" y="368" width="52" height="95" fill="#1E3A6B" opacity="0.92" transform="rotate(5 326 415)" />
            <rect x="300" y="368" width="52" height="95" fill="none" stroke="#E67A22" stroke-width="1.5" stroke-dasharray="3 3" transform="rotate(5 326 415)" />
            <rect x="306" y="375" width="22" height="13" fill="#F4F4F1" transform="rotate(5 326 415)" />
            <text x="310" y="385" font-family="JetBrains Mono, monospace" font-size="10" fill="#0E2142" transform="rotate(5 326 415)">02</text>
          </g>

          <!-- segment 03: mid-cascade -->
          <g class="segment" style="animation-delay:250ms">
            <rect x="374" y="392" width="46" height="82" fill="#4C7A5D" opacity="0.88" transform="rotate(13 397 433)" />
            <rect x="374" y="392" width="46" height="82" fill="none" stroke="#E67A22" stroke-width="1.5" stroke-dasharray="3 3" transform="rotate(13 397 433)" />
            <text x="380" y="406" font-family="JetBrains Mono, monospace" font-size="10" fill="#F4F4F1" transform="rotate(13 397 433)">03</text>
          </g>

          <!-- segment 04: processed scrap, near output -->
          <g class="segment" style="animation-delay:500ms">
            <rect x="446" y="440" width="36" height="36" fill="#6B695F" opacity="0.85" transform="rotate(22 464 458)" />
            <text x="450" y="454" font-family="JetBrains Mono, monospace" font-size="9" fill="#F4F4F1" transform="rotate(22 464 458)">04</text>
          </g>

          <!-- scrap stack, final output -->
          <rect x="500" y="452" width="30" height="10" fill="#8A8878" opacity="0.6" />
          <rect x="506" y="440" width="30" height="10" fill="#8A8878" opacity="0.75" />
          <rect x="512" y="428" width="30" height="10" fill="#8A8878" opacity="0.9" />

          <!-- recycle mark -->
          <g transform="translate(560, 412)" opacity="0.9">
            <path d="M12 2a10 10 0 019.5 7M22 2v7h-7M2 12a10 10 0 019.5 10M2 12v7h7M12 22a10 10 0 019.5-7"
              stroke="#4C7A5D" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round" />
          </g>

          <text x="30" y="500" font-family="JetBrains Mono, monospace" font-size="11" letter-spacing="1.5" fill="#8A8878">ALANG YARD — PLOT REF. RGSR</text>
        </svg>

        <p class="mt-4 pt-4 border-t border-stone-200 font-mono text-[0.65rem] tracking-widest uppercase text-stone-400">
          Fig. 01 — Controlled hull sectioning at the Alang facility
        </p>
      </div>
    </div>
  </div>

  <div class="relative border-y border-stone-300/70 bg-white/60 overflow-hidden">
    <div class="ticker flex items-center gap-16 py-4 whitespace-nowrap">
      {Array(3).fill(['SHIP RECYCLING', 'CONSTRUCTION CEMENT', 'ACC BLOCKS', 'INDUSTRIAL PIPES', 'TMT BARS', 'EST. 1991']).flat().map((item) => (
        <span class="eyebrow text-stone-500 flex items-center gap-16">
          {item}
          <span class="w-1 h-1 rounded-full bg-rust-500/60"></span>
        </span>
      ))}
    </div>
  </div>
</section>

<style>
  .hero-fade {
    opacity: 0;
    transform: translateY(16px);
    animation: heroFadeUp 0.7s ease-out forwards;
  }
  @keyframes heroFadeUp {
    to { opacity: 1; transform: translateY(0); }
  }

  .lift-group {
    animation: liftBob 3.5s ease-in-out infinite;
    transform-origin: center;
  }
  @keyframes liftBob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }

  .segment {
    animation: segmentFloat 4s ease-in-out infinite;
    transform-origin: center;
  }
  @keyframes segmentFloat {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-5px); }
  }

  .cutline {
    animation: dashMarch 1.2s linear infinite;
  }
  @keyframes dashMarch {
    to { stroke-dashoffset: -16; }
  }

  .ticker {
    width: max-content;
    animation: tickerScroll 42s linear infinite;
  }
  @keyframes tickerScroll {
    from { transform: translateX(0); }
    to { transform: translateX(-33.333%); }
  }
</style>