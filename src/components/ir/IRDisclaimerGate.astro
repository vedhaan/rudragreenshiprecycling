<script>
  // Must match the key used in the inline script in investor-relations.astro
  const KEY = 'rgsr-ir-disclaimer'

  document.getElementById('ir-gate-continue')?.addEventListener('click', () => {
    try {
      sessionStorage.setItem(KEY, 'accepted')
    } catch {}

    document.documentElement.setAttribute('data-ir-accepted', 'true')

    // If the visitor arrived on a deep link like #ir-policies, jump to it after accepting
    try {
      const target = window.location.hash ? document.querySelector(window.location.hash) : null
      if (target) {
        target.scrollIntoView()
        return
      }
    } catch {}
    window.scrollTo(0, 0)
  })
</script>