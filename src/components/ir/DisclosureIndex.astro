---

<section id="ir-index" data-title="Disclosure Index" class="max-w-4xl pt-16 mt-16 border-t border-stone-300">
  <details class="group">
    <summary class="flex items-center gap-3 cursor-pointer font-display font-semibold text-xl text-navy-950 list-none mb-6">
      <span class="flex items-center justify-center w-7 h-7 rounded-full border border-stone-300 text-sm font-mono shrink-0 group-open:hidden">+</span>
      <span class="hidden items-center justify-center w-7 h-7 rounded-full border border-stone-300 text-sm font-mono shrink-0 group-open:flex">–</span>
      Full disclosure index — all 45 checklist items mapped to this page
    </summary>

    <div class="overflow-x-auto border border-stone-200 bg-white">
      <table class="w-full text-xs min-w-[760px]">
        <thead class="sticky top-0 bg-paper">
          <tr class="border-b border-stone-200">
            <th class="text-left font-mono text-[10px] text-stone-400 uppercase tracking-wide px-4 py-3 w-10">No.</th>
            <th class="text-left font-mono text-[10px] text-stone-400 uppercase tracking-wide px-4 py-3">Information</th>
            <th class="text-left font-mono text-[10px] text-stone-400 uppercase tracking-wide px-4 py-3 whitespace-nowrap">Provision</th>
            <th class="text-left font-mono text-[10px] text-stone-400 uppercase tracking-wide px-4 py-3 whitespace-nowrap">Section</th>
            <th class="text-left font-mono text-[10px] text-stone-400 uppercase tracking-wide px-4 py-3">Status</th>
          </tr>
        </thead>
        <tbody>
          {items.map((it) => (
            <tr class="border-b border-stone-100 last:border-0 hover:bg-paper transition-colors">
              <td class="font-mono text-stone-400 px-4 py-3">{it.no}</td>
              <td class="text-navy-950 px-4 py-3 max-w-xs">{it.info}</td>
              <td class="font-mono text-stone-500 px-4 py-3 whitespace-nowrap">{it.reg}</td>
              <td class="px-4 py-3 whitespace-nowrap">
                <a href={`#${it.target}`} class="text-rust-500 font-medium hover:text-rust-600">{it.section}</a>
              </td>
              <td class="px-4 py-3">
                <span class={`eyebrow px-2 py-0.5 rounded-full border whitespace-nowrap ${statusMap[it.status]}`}>{statusLabel[it.status]}</span>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </details>
</section>