---
const sections = [
  { id: 'ir-overview', roman: 'I', label: 'Company Overview' },
  { id: 'ir-governance', roman: 'II', label: 'Board & Governance' },
  { id: 'ir-policies', roman: 'III', label: 'Policies & Codes' },
  { id: 'ir-financials', roman: 'IV', label: 'Financials & Reports' },
  { id: 'ir-shareholding', roman: 'V', label: 'Shareholding Pattern' },
  { id: 'ir-regulatory', roman: 'VI', label: 'Regulatory Disclosures' },
  { id: 'ir-offer', roman: 'VII', label: 'Offer Document' },
  { id: 'ir-grievance', roman: 'VIII', label: 'Investor Grievance' },
  { id: 'ir-index', roman: '', label: 'Full Disclosure Index' },
]
---

<div class="sticky top-20 z-20 -mx-6 px-6 py-3 bg-paper/95 backdrop-blur border-b border-stone-200 overflow-x-auto mb-10">
  <div class="flex gap-2 w-max">
    {sections.map((s) => (
      <a href={`#${s.id}`} data-ir-link-mobile={s.id}
        class="ir-nav-link-mobile whitespace-nowrap text-xs font-medium px-3.5 py-2 border border-stone-300 text-stone-600 rounded-full">
        {s.roman ? `${s.roman}. ${s.label}` : s.label}
      </a>
    ))}
  </div>
</div>

<style>
  .ir-nav-link-mobile.is-active {
    background: #0E2142;
    border-color: #0E2142;
    color: #fff;
  }
</style>

<script>
  const links = Array.from(document.querySelectorAll('.ir-nav-link-mobile')) as HTMLAnchorElement[]
  const targets = Array.from(document.querySelectorAll('section[id^="ir-"]')) as HTMLElement[]

  links.forEach((link) => {
    link.addEventListener('click', (e) => {
      e.preventDefault()
      const target = document.getElementById(link.dataset.irLinkMobile!)
      if (!target) return
      const offset = target.getBoundingClientRect().top + window.scrollY - 140
      window.scrollTo({ top: offset, behavior: 'smooth' })
    })
  })

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return
        const id = entry.target.id
        links.forEach((l) => l.classList.toggle('is-active', l.dataset.irLinkMobile === id))
      })
    },
    { rootMargin: '-15% 0px -70% 0px', threshold: 0 }
  )
  targets.forEach((t) => observer.observe(t))
</script>