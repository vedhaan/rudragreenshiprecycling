---
interface Props {
  name: string
  desc?: string
  provision: string
  status: 'pending' | 'conditional' | 'na' | 'live'
  href?: string | null
}
const { name, desc, provision, status, href = null } = Astro.props

const statusMap = {
  pending: { label: 'Pending upload', cls: 'text-rust-500 bg-rust-500/10 border-rust-500/25' },
  conditional: { label: 'Conditional', cls: 'text-amber-600 bg-amber-500/10 border-amber-500/30' },
  na: { label: 'Not applicable', cls: 'text-stone-500 bg-stone-200/60 border-stone-300' },
  live: { label: 'Available', cls: 'text-sage-600 bg-sage-600/10 border-sage-600/30' },
}
const s = statusMap[status]
---
<div class="flex flex-col sm:flex-row sm:items-center gap-4 sm:gap-6 px-5 sm:px-6 py-5 border-b border-stone-200 last:border-b-0 min-w-0">
  <span class="hidden sm:flex items-center justify-center w-10 h-10 rounded-full border border-stone-200 bg-paper shrink-0">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" class="text-navy-800"><path d="M9 4h12l6 6v20H9V4z" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" transform="translate(-3,-2) scale(0.72)"/><path d="M4 4h16v16H4z M22 6l-10 7L2 6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" opacity="0"/></svg>
  </span>

  <div class="flex-1 min-w-0">
    <p class="font-semibold text-navy-950 text-sm">{name}</p>
    {desc && <p class="text-stone-500 text-xs mt-1 leading-relaxed">{desc}</p>}
    <p class="font-mono text-[10px] text-stone-400 mt-1.5">{provision}</p>
  </div>

  <div class="flex items-center gap-3 shrink-0">
    <span class={`eyebrow px-2 py-0.5 rounded-full border ${s.cls}`}>{s.label}</span>
    {status !== 'na' && (
      href ? (
        <a href={href} download class="flex items-center gap-1.5 border border-stone-300 text-navy-800 text-xs font-medium px-3 py-2 hover:border-navy-900 transition-colors">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none"><path d="M12 3v12m0 0l-4-4m4 4l4-4M4 21h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          Download
        </a>
      ) : (
        <span class="flex items-center gap-1.5 border border-stone-200 text-stone-400 text-xs font-medium px-3 py-2 cursor-not-allowed">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none"><path d="M12 3v12m0 0l-4-4m4 4l4-4M4 21h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          Download
        </span>
      )
    )}
  </div>
</div>