---
const pages = [
  {
    num: '01',
    title: 'The Recycling Process',
    desc: 'From pre-arrival documentation through controlled dismantling to material recovery — the six-stage sequence every vessel moves through.',
    href: '/process',
  },
  {
    num: '02',
    title: 'Health & Safety Measures',
    desc: 'The health, environmental, and waste management measures maintained across every stage of yard operations.',
    href: '/measures',
  },
  {
    num: '03',
    title: 'Hong Kong Convention',
    desc: 'The international framework this entire process is built around — and what it requires of an authorized facility.',
    href: '/convention',
  },
]
---

<section class="relative bg-navy-950 py-20 lg:py-28 overflow-hidden mt-4">
  <div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
    <div class="absolute -right-24 top-[-10%] w-[40%] h-[140%] bg-white/[0.03] [clip-path:polygon(30%_0,100%_0,100%_100%,0_100%)]"></div>
    <div class="absolute -right-10 top-[-5%] w-[24%] h-[120%] bg-rust-500/[0.05] [clip-path:polygon(35%_0,100%_0,100%_100%,5%_100%)] hidden lg:block"></div>
  </div>

  <div class="relative max-w-[1800px] mx-auto px-6 sm:px-10 xl:px-16 2xl:px-20">
    <div class="flex items-end justify-between flex-wrap gap-6 mb-16 lg:mb-20">
      <div>
        <div class="flex items-center gap-3 mb-5">
          <span class="w-8 h-px bg-rust-500 shrink-0"></span>
          <p class="eyebrow text-rust-400">Explore the standard</p>
        </div>
        <h2 class="font-display font-semibold text-3xl lg:text-4xl xl:text-5xl text-white max-w-xl leading-[1.1]">
          Three pages, one operating standard.
        </h2>
      </div>
    </div>

    <div class="border-t border-white/15">
      {pages.map((p) => (
        <a href={p.href} class="group relative flex flex-col sm:flex-row sm:items-center justify-between gap-4 py-8 border-b border-white/15 transition-colors duration-300 hover:bg-white/[0.04] px-3 -mx-3 min-w-0">
          <div class="flex items-start sm:items-center gap-5 xl:gap-8 min-w-0">
            <span class="font-mono text-xs text-white/40 shrink-0 w-6 transition-colors duration-300 group-hover:text-rust-400">{p.num}</span>
            <div class="min-w-0">
              <h3 class="font-display font-semibold text-2xl xl:text-3xl text-white transition-colors duration-300 group-hover:text-rust-100">{p.title}</h3>
              <p class="text-stone-300 text-sm mt-2 max-w-lg leading-relaxed">{p.desc}</p>
            </div>
          </div>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" class="text-white/30 shrink-0 transition-all duration-300 group-hover:text-rust-400 group-hover:translate-x-1">
            <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span class="absolute left-0 bottom-0 h-0.5 w-0 bg-rust-500 transition-all duration-300 ease-out group-hover:w-full"></span>
        </a>
      ))}
    </div>
  </div>
</section>