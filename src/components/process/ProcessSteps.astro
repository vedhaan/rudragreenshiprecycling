---
const steps = [
  {
    title: 'Pre-arrival & documentation',
    desc: 'The vessel\'s Inventory of Hazardous Materials (IHM) and ship recycling plan are reviewed against HKC requirements before the vessel is accepted into the yard.',
    icon: 'M9 12h6M9 16h6M9 8h2M5 4h14a1 1 0 011 1v14a1 1 0 01-1 1H5a1 1 0 01-1-1V5a1 1 0 011-1z',
  },
  {
    title: 'Beaching & positioning',
    desc: 'The vessel is beached at high tide into a designated cutting position, allowing controlled access along the full length of the hull.',
    icon: 'M2 20c2 1.5 4 1.5 6 0s4-1.5 6 0 4 1.5 6 0 M4 20V9l14-4v11 M4 12l14-4',
  },
  {
    title: 'Pre-cleaning & waste removal',
    desc: 'Fuel, oils, and hazardous liquids are drained and removed before any cutting begins, in line with HKC pre-cleaning requirements.',
    icon: 'M12 3s6 6.5 6 11a6 6 0 01-12 0c0-4.5 6-11 6-11z',
  },
  {
    title: 'Controlled dismantling',
    desc: 'The hull is sectioned in a planned sequence, from superstructure down, using designated cutting zones — with a separate zone for oil material handling.',
    icon: 'M4 20L20 4 M4 4l4 4m-4 8l4 4m8-16l4 4m-4 8l4 4',
  },
  {
    title: 'Waste segregation',
    desc: 'Recoverable steel, hazardous waste, and other materials are segregated at the point of cutting and routed to their respective handling areas.',
    icon: 'M4 7h16M4 7l2 13h12l2-13M9 7V4h6v3',
  },
  {
    title: 'Material recovery & disposal',
    desc: 'Steel is prepared for re-rolling and resale; hazardous waste is disposed of through certified facilities in accordance with pollution control regulations.',
    icon: 'M12 2a10 10 0 019.5 7M22 2v7h-7M2 12a10 10 0 019.5 10M2 12v7h7M12 22a10 10 0 019.5-7',
  },
]
---

<section class="relative bg-paper py-4 lg:py-8 overflow-hidden">
  <div class="max-w-[1800px] mx-auto px-6 sm:px-10 xl:px-16 2xl:px-20">
    <div class="max-w-4xl mb-16 lg:mb-20">
      <div class="flex items-center gap-3 mb-5">
        <span class="w-8 h-px bg-sage-600 shrink-0"></span>
        <p class="eyebrow text-sage-600">The recycling process</p>
      </div>
      <h2 class="font-display font-semibold text-3xl lg:text-4xl text-navy-950 leading-[1.1]">
        From beaching to material recovery.
      </h2>
    </div>

    <div class="grid lg:grid-cols-[auto_1fr] gap-x-10 xl:gap-x-16 max-w-4xl">

      <!-- LIVE PROGRESS RAIL -->
      <div class="hidden lg:flex flex-col items-center relative w-11 shrink-0">
        <div class="absolute top-0 bottom-0 w-px bg-stone-300"></div>
        <div id="process-rail-fill" class="absolute top-0 w-px bg-rust-500 transition-[height] duration-300 ease-out" style="height: 0%"></div>
      </div>

      <!-- STEPS -->
      <div>
        {steps.map((s, i) => (
          <div class="process-step group flex flex-col lg:flex-row gap-5 lg:gap-8 py-8 border-b border-stone-300 last:border-b-0 opacity-0 translate-y-4 transition-all duration-700 ease-out" data-step={i}>

            <!-- marker: mobile inline, desktop pulled onto the rail -->
            <div class="flex items-center gap-4 lg:contents">
              <span class="step-marker lg:absolute lg:-ml-[3.75rem] flex items-center justify-center w-11 h-11 rounded-full bg-white border-2 border-stone-300 shrink-0 transition-colors duration-500">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" class="step-icon text-stone-400 transition-colors duration-500">
                  <path d={s.icon} stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
              <span class="lg:hidden font-mono text-xs text-stone-400">{String(i + 1).padStart(2, '0')}</span>
            </div>

            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-3 mb-2">
                <span class="hidden lg:inline font-mono text-xs text-stone-400">{String(i + 1).padStart(2, '0')}</span>
                <p class="step-title font-display font-semibold text-lg lg:text-xl text-stone-500 transition-colors duration-500">{s.title}</p>
              </div>
              <p class="text-stone-600 text-sm leading-relaxed max-w-xl">{s.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <div class="max-w-4xl mt-6 flex items-start gap-3 border border-dashed border-stone-300 bg-stone-100/60 px-5 py-4">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" class="text-stone-400 shrink-0 mt-0.5"><path d="M12 9v4m0 4h.01M12 2a10 10 0 100 20 10 10 0 000-20z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <p class="text-stone-500 text-xs leading-relaxed">
        This sequence reflects the general HKC-compliant ship recycling process. Confirm with the yard
        team that each step and description accurately matches Rudra's actual operating procedure
        before this page goes live.
      </p>
    </div>
  </div>
</section>

<style>
  .process-step.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
  .process-step.is-active .step-marker {
    border-color: #E67A22;
    background: #E67A22;
    box-shadow: 0 0 0 4px rgba(230, 122, 34, 0.15);
  }
  .process-step.is-active .step-icon {
    color: #fff;
  }
  .process-step.is-active .step-title {
    color: #0E2142;
  }
  .process-step.is-passed .step-marker {
    border-color: #4C7A5D;
    background: #4C7A5D;
  }
  .process-step.is-passed .step-icon {
    color: #fff;
  }
  .process-step.is-passed .step-title {
    color: #0E2142;
  }
  @media (prefers-reduced-motion: reduce) {
    .process-step { opacity: 1; transform: none; transition: none; }
  }
</style>

<script>
  const steps = Array.from(document.querySelectorAll('.process-step')) as HTMLElement[]
  const rail = document.getElementById('process-rail-fill')
  let activeIndex = -1

  const revealObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible')
        }
      })
    },
    { threshold: 0.15 }
  )
  steps.forEach((s) => revealObserver.observe(s))

  const activeObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        const idx = Number((entry.target as HTMLElement).dataset.step)
        if (entry.isIntersecting) {
          activeIndex = idx
        }
      })

      steps.forEach((s, i) => {
        s.classList.remove('is-active', 'is-passed')
        if (i === activeIndex) s.classList.add('is-active')
        else if (i < activeIndex) s.classList.add('is-passed')
      })

      if (rail && steps.length > 0) {
        const pct = activeIndex >= 0 ? ((activeIndex + 1) / steps.length) * 100 : 0
        rail.style.height = `${pct}%`
      }
    },
    { rootMargin: '-45% 0px -45% 0px', threshold: 0 }
  )
  steps.forEach((s) => activeObserver.observe(s))
</script>