---
const certs = [
  {
    name: "ISO 14001:2015",
    sub: "Environmental Management",
    file: "/documents/certifications/ISO_14001_20.01.2029.pdf",
    preview: "/img/certificate/ISO_14001_20.01.2029_page-0001.jpg",
  },
  {
    name: "ISO 9001:2015",
    sub: "Quality Management",
    file: "/documents/certifications/ISO_9001_20.01.2029.pdf",
    preview: "/img/certificate/ISO_9001_20.01.2029_page-0001.jpg",
  },
  {
    name: "ISO 45001",
    sub: "Occupational Health & Safety",
    file: "/documents/certifications/ISO_45001_20.01.2029.pdf",
    preview: "/img/certificate/ISO_45001_20.01.2029_page-0001.jpg",
  },
  {
    name: "ISO 30001",
    sub: "Ship Recycling Management",
    file: "/documents/certifications/ISO_30001_27.01.2027.pdf",
    preview: "/img/certificate/ISO_30001_27.01.2027_page-0001.jpg",
  },
  {
    name: "ISO 50001",
    sub: "Energy Management",
    file: "/documents/certifications/ISO_50001_16.04.2027.pdf",
    preview: "/img/certificate/ISO_50001_16.04.2027_page-0001.jpg",
  },
  {
    name: "ISO 55001",
    sub: "Asset Management",
    file: "/documents/certifications/ISO_55001_16.04.2027.pdf",
    preview: "/img/certificate/ISO_55001_16.04.2027_page-0001.jpg",
  },
];
---

<section
  class="relative bg-white border-y border-stone-200 py-24 lg:py-32 overflow-hidden"
>
  <div
    class="hidden xl:block absolute inset-0 pointer-events-none opacity-[0.03]"
    style="background-image: linear-gradient(#0E2142 1px, transparent 1px), linear-gradient(90deg, #0E2142 1px, transparent 1px); background-size: 64px 64px;"
  >
  </div>

  <div class="relative max-w-[1800px] mx-auto px-6 sm:px-10 xl:px-16 2xl:px-20">
    <div
      class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-8 mb-14 lg:mb-20"
    >
      <div class="max-w-xl">
        <div class="flex items-center gap-3 mb-6">
          <span class="w-8 h-px bg-rust-500"></span>
          <p class="eyebrow text-sage-600">Verified & compliant</p>
        </div>
        <h2
          class="font-display font-semibold text-3xl lg:text-4xl xl:text-[2.75rem] text-navy-950 leading-[1.1]"
        >
          International Certifications
        </h2>
        <p class="mt-6 text-stone-600 text-base lg:text-lg leading-relaxed">
          Our operations are certified and maintained across environmental,
          quality, occupational health and safety, and ship recycling management
          systems recognized internationally.
        </p>
      </div>

      <div class="flex items-baseline gap-3 shrink-0">
        <span
          class="font-display font-semibold text-5xl xl:text-6xl text-navy-950"
          >{certs.length}</span
        >
        <span class="eyebrow text-stone-500 leading-tight max-w-[9rem]"
          >Active certifications maintained across the yard</span
        >
      </div>
    </div>

    <div
      class="flex lg:grid lg:grid-cols-6 gap-5 xl:gap-6 overflow-x-auto lg:overflow-visible pb-4 lg:pb-0 -mx-6 px-6 sm:-mx-10 sm:px-10 lg:mx-0 lg:px-0 snap-x snap-mandatory scrollbar-hide"
    >
      {
        certs.map((cert, i) => (
          <button
            type="button"
            class="cert-trigger group relative bg-paper border border-stone-200 flex flex-col text-left w-[220px] shrink-0 lg:w-auto overflow-hidden snap-start
                 transition-all duration-300 ease-out
                 hover:-translate-y-1 hover:border-navy-900/20 hover:shadow-[0_4px_10px_rgba(14,33,66,0.05),0_18px_36px_-16px_rgba(14,33,66,0.16)]
                 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-rust-500 focus-visible:ring-offset-2"
            data-file={cert.file}
            data-name={cert.name}
            data-sub={cert.sub}
          >
            <span class="absolute top-3 left-3 z-10 font-mono text-[0.65rem] text-white/90 bg-navy-950/60 backdrop-blur-sm px-2 py-0.5">
              {String(i + 1).padStart(2, "0")}
            </span>

            <div class="relative h-56 xl:h-64 bg-stone-100 border-b border-stone-200 overflow-hidden flex items-center justify-center p-4">
              {cert.preview ? (
                <img
                  src={cert.preview}
                  alt={`${cert.name} certificate preview`}
                  loading="lazy"
                  decoding="async"
                  class="cert-preview w-full h-full object-contain bg-white shadow-[0_2px_8px_rgba(14,33,66,0.12)] transition-transform duration-500 group-hover:scale-[1.02]"
                />
              ) : (
                <div class="w-full h-full flex items-center justify-center bg-stone-100">
                  <span class="font-mono text-[10px] tracking-[0.2em] text-stone-400">
                    CERTIFICATE
                  </span>
                </div>
              )}
            </div>

            <div class="p-5 flex flex-col gap-1">
              <h3 class="font-display font-semibold text-base text-navy-950 leading-snug">
                {cert.name}
              </h3>
              <p class="text-stone-500 text-xs leading-snug">{cert.sub}</p>
              <span class="flex items-center gap-1.5 mt-3 text-xs font-medium text-navy-900 opacity-0 -translate-y-1 group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-300">
                View Certificate
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none">
                  <path
                    d="M7 17L17 7M17 7H7M17 7V17"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>
            </div>

            <span class="absolute bottom-0 left-0 h-0.5 w-0 bg-rust-500 group-hover:w-full transition-all duration-300" />
          </button>
        ))
      }
    </div>

    <p class="lg:hidden mt-4 eyebrow text-stone-400">
      ← Swipe to view all certifications →
    </p>
  </div>
</section>

<div
  id="cert-modal"
  class="fixed inset-0 z-[100] hidden items-center justify-center p-4 sm:p-8"
>
  <div
    id="cert-modal-backdrop"
    class="absolute inset-0 bg-navy-950/80 backdrop-blur-sm"
  >
  </div>
  <div
    class="relative bg-white max-w-3xl w-full h-[85vh] flex flex-col overflow-hidden"
  >
    <div
      class="flex items-center justify-between px-6 py-4 border-b border-stone-200 shrink-0"
    >
      <div>
        <h3
          id="cert-modal-name"
          class="font-display font-semibold text-lg text-navy-950"
        >
        </h3>
        <p id="cert-modal-sub" class="text-stone-500 text-xs"></p>
      </div>
      <div class="flex items-center gap-2">
        <a
          id="cert-modal-open-tab"
          href="#"
          target="_blank"
          rel="noopener"
          class="flex items-center gap-1.5 text-xs font-medium text-navy-800 border border-stone-300 px-3 py-2 hover:border-navy-900 transition-colors"
        >
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none"
            ><path
              d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"></path></svg
          >
          Open in new tab
        </a>
        <button
          id="cert-modal-close"
          type="button"
          aria-label="Close"
          class="p-2 text-stone-500 hover:text-navy-950 transition-colors"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
            ><path
              d="M6 6l12 12M18 6L6 18"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"></path></svg
          >
        </button>
      </div>
    </div>
    <div class="flex-1 bg-stone-100">
      <iframe
        id="cert-modal-frame"
        src=""
        title="Certificate document"
        class="w-full h-full border-0"></iframe>
    </div>
  </div>
</div>

<style>
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-hide {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
</style>

<script>
  // -----------------------------
  // Modal
  // -----------------------------

  const modal = document.getElementById("cert-modal") as HTMLElement;
  const backdrop = document.getElementById(
    "cert-modal-backdrop",
  ) as HTMLElement;
  const closeBtn = document.getElementById(
    "cert-modal-close",
  ) as HTMLElement;

  const frame = document.getElementById(
    "cert-modal-frame",
  ) as HTMLIFrameElement;

  const openTab = document.getElementById(
    "cert-modal-open-tab",
  ) as HTMLAnchorElement;

  const modalName = document.getElementById(
    "cert-modal-name",
  ) as HTMLElement;

  const modalSub = document.getElementById(
    "cert-modal-sub",
  ) as HTMLElement;


  function openModal(file: string, name: string, sub: string) {
    if (!modal || !frame) return;

    frame.src = file;

    if (openTab) {
      openTab.href = file;
    }

    if (modalName) {
      modalName.textContent = name;
    }

    if (modalSub) {
      modalSub.textContent = sub;
    }

    modal.classList.remove("hidden");
    modal.classList.add("flex");

    document.body.style.overflow = "hidden";
  }


  function closeModal() {
    if (!modal) return;

    modal.classList.add("hidden");
    modal.classList.remove("flex");

    document.body.style.overflow = "";

    if (frame) {
      frame.src = "";
    }
  }


  // -----------------------------
  // Certificate buttons
  // -----------------------------

  document.querySelectorAll(".cert-trigger").forEach((btn) => {
    btn.addEventListener("click", () => {
      const file = btn.getAttribute("data-file") || "";
      const name = btn.getAttribute("data-name") || "";
      const sub = btn.getAttribute("data-sub") || "";

      openModal(file, name, sub);
    });
  });


  // -----------------------------
  // Close modal
  // -----------------------------

  backdrop?.addEventListener("click", closeModal);

  closeBtn?.addEventListener("click", closeModal);


  // ESC key
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      closeModal();
    }
  });
</script>