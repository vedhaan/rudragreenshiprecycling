---
const stats = [
  { value: '10+ km', label: 'Coastline of ship recycling plots at Alang', icon: 'M2 12h20M2 12a10 10 0 0110-10M2 12a10 10 0 0010 10M12 2a15 15 0 010 20M12 2a15 15 0 000 20' },
  { value: '150+', label: 'Recycling yards operating along the stretch', icon: 'M3 21h18M5 21V10l7-7 7 7v11M9 21v-6h6v6' },
  { value: '1983', label: 'Ship recycling began at Alang', icon: 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z' },
]
---

<section class="relative bg-navy-950 py-20 lg:py-28 overflow-hidden">
  <div class="absolute -top-32 -left-32 w-[550px] h-[550px] rounded-full bg-sage-600/[0.10] blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-40 -right-20 w-[450px] h-[450px] rounded-full bg-rust-500/[0.08] blur-3xl pointer-events-none"></div>
  <div class="absolute top-1/3 right-1/4 w-[300px] h-[300px] rounded-full bg-white/[0.03] blur-3xl pointer-events-none"></div>

  <div class="relative max-w-[1800px] mx-auto px-6 sm:px-10 xl:px-16 2xl:px-20">
    <div class="max-w-2xl mb-16">
      <div class="flex items-center gap-3 mb-5">
        <span class="w-8 h-px bg-rust-500 shrink-0"></span>
        <p class="eyebrow text-paper">A hub, not a single yard</p>
      </div>
      <h2 class="font-display font-semibold text-3xl lg:text-4xl text-white leading-[1.15]">
        Rudra operates as one facility within a much larger ecosystem.
      </h2>
    </div>

    <div class="grid sm:grid-cols-3 gap-6 xl:gap-8">
      {stats.map((s) => (
        <div class="bg-white/[0.04] border border-white/10 p-7 xl:p-8">
          <span class="flex items-center justify-center w-11 h-11 rounded-full bg-rust-500/15 border border-rust-500/25 mb-6">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" class="text-rust-300">
              <path d={s.icon} stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
          <p class="font-display font-semibold text-4xl xl:text-5xl text-white mb-3">{s.value}</p>
          <p class="text-stone-300 text-sm leading-relaxed">{s.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>