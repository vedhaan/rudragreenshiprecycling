---
const articles = [
  {
    num: '01',
    title: 'What the Convention is',
    body: 'The Hong Kong International Convention for the Safe and Environmentally Sound Recycling of Ships (HKC) is an International Maritime Organization (IMO) treaty adopted in 2009, setting requirements for ship design, construction, operation, and recycling to reduce risks to human health, safety, and the environment.',
    icon: 'M4 4v16h16 M9 9h6M9 13h6M9 17h3',
    color: 'rust',
  },
  {
    num: '02',
    title: 'Inventory of Hazardous Materials (IHM)',
    body: 'Every vessel entering a recycling facility must carry an IHM — a certified list of hazardous materials on board, including their location and approximate quantity — verified before recycling begins.',
    icon: 'M12 9v4m0 4h.01M10.3 3.9L2 18a2 2 0 001.7 3h16.6a2 2 0 001.7-3L13.7 3.9a2 2 0 00-3.4 0z',
    color: 'amber',
  },
  {
    num: '03',
    title: 'Authorized recycling facilities',
    body: 'Ships may only be recycled at facilities authorized by their competent authority to operate in accordance with the Convention, following a Ship Recycling Facility Plan.',
    icon: 'M12 2l7 3v6c0 5-3.4 8.7-7 10-3.6-1.3-7-5-7-10V5l7-3z M9 12l2 2 4-4',
    color: 'sage',
  },
  {
    num: '04',
    title: 'Ship Recycling Plan',
    body: 'Before recycling, a Ship Recycling Plan is developed for the specific vessel, based on its IHM, detailing how it will be dismantled safely and in an environmentally sound manner.',
    icon: 'M9 12h6M9 16h6M9 8h2M5 4h14a1 1 0 011 1v14a1 1 0 01-1 1H5a1 1 0 01-1-1V5a1 1 0 011-1z',
    color: 'navy',
  },
  {
    num: '05',
    title: 'Worker safety & environmental protection',
    body: 'The Convention requires controls on emissions, worker exposure to hazardous materials, and prevention of adverse effects on human health and the marine environment during recycling operations.',
    icon: 'M12 22s8-4 8-11V5l-8-3-8 3v6c0 7 8 11 8 11z',
    color: 'sage',
  },
]

const colorMap = {
  rust: { ring: 'border-rust-500/40 bg-rust-500/10', icon: 'text-rust-500', num: 'text-rust-500' },
  amber: { ring: 'border-amber-500/40 bg-amber-500/10', icon: 'text-amber-600', num: 'text-amber-600' },
  sage: { ring: 'border-sage-600/40 bg-sage-600/10', icon: 'text-sage-600', num: 'text-sage-600' },
  navy: { ring: 'border-navy-900/25 bg-navy-900/5', icon: 'text-navy-800', num: 'text-navy-800' },
}
---

<section class="relative bg-paper py-4 lg:py-8 overflow-hidden">
  <div class="max-w-[1800px] mx-auto px-6 sm:px-10 xl:px-16 2xl:px-20">
    <div class="max-w-4xl mb-16 lg:mb-20">
      <div class="flex items-center gap-3 mb-5">
        <span class="w-8 h-px bg-sage-600 shrink-0"></span>
        <p class="eyebrow text-sage-600">The framework</p>
      </div>
      <h2 class="font-display font-semibold text-3xl lg:text-4xl text-navy-950 leading-[1.1]">
        The standard we operate to.
      </h2>
    </div>

    <div class="grid lg:grid-cols-[260px_1fr] gap-12 xl:gap-16">

      <!-- INDEX RAIL -->
      <div class="hidden lg:block lg:sticky lg:top-28 lg:self-start">
        <p class="eyebrow text-stone-400 mb-5">On this page</p>
        <nav class="flex flex-col gap-1">
          {articles.map((a) => (
            <a href={`#article-${a.num}`} class="convention-nav-link flex items-center gap-3 px-3 py-2.5 rounded-sm border border-transparent hover:bg-white hover:border-stone-200 transition-colors group" data-target={`article-${a.num}`}>
              <span class:list={['flex items-center justify-center w-6 h-6 rounded-full border shrink-0 transition-colors', colorMap[a.color].ring]}>
                <span class:list={['font-mono text-[10px] font-semibold', colorMap[a.color].num]}>{a.num.slice(1)}</span>
              </span>
              <span class="text-sm text-stone-600 group-hover:text-navy-900 transition-colors leading-tight">{a.title}</span>
            </a>
          ))}
        </nav>
      </div>

      <!-- ARTICLES -->
      <div class="max-w-3xl flex flex-col gap-5">
        {articles.map((a) => (
          <div id={`article-${a.num}`} class="scroll-mt-28 bg-white border border-stone-200 p-6 lg:p-8">
            <div class="flex items-start gap-5">
              <span class:list={['flex items-center justify-center w-12 h-12 rounded-full border shrink-0', colorMap[a.color].ring]}>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" class={colorMap[a.color].icon}>
                  <path d={a.icon} stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
              <div class="min-w-0 flex-1">
                <span class:list={['block font-mono text-xs mb-1.5', colorMap[a.color].num]}>{a.num}</span>
                <h3 class="font-display font-semibold text-lg lg:text-xl text-navy-950 leading-snug mb-2">{a.title}</h3>
                <p class="text-stone-600 text-sm lg:text-base leading-relaxed">{a.body}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const links = Array.from(document.querySelectorAll('.convention-nav-link')) as HTMLElement[]
  const sections = links.map((l) => document.getElementById(l.dataset.target!)).filter(Boolean) as HTMLElement[]

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        const link = links.find((l) => l.dataset.target === entry.target.id)
        if (!link) return
        if (entry.isIntersecting) {
          links.forEach((l) => l.classList.remove('bg-white', 'border-stone-200'))
          link.classList.add('bg-white', 'border-stone-200')
        }
      })
    },
    { rootMargin: '-20% 0px -70% 0px', threshold: 0 }
  )
  sections.forEach((s) => observer.observe(s))
</script>