---
const activities = [
  {
    title: 'CSR',
    tag: 'Corporate Responsibility',
    desc: 'Community programs and social initiatives carried out alongside yard operations, as part of the group\'s ongoing commitment beyond recycling.',
    icon: 'M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z',
  },
  {
    title: 'Environmental Care',
    tag: 'Sustainability',
    desc: 'Environmental stewardship built into daily operations — from waste segregation to emissions control across the yard.',
    icon: 'M12 2C8 2 5 5 5 9c0 5 7 13 7 13s7-8 7-13c0-4-3-7-7-7z M12 12a3 3 0 100-6 3 3 0 000 6z',
  },
  {
    title: 'Cultural',
    tag: 'Community',
    desc: 'Cultural events and observances that connect the workforce and the wider Alang community throughout the year.',
    icon: 'M4 21h16 M6 21V10l6-6 6 6v11 M9 21v-6h6v6',
  },
  {
    title: 'Training & Safety',
    tag: 'Workforce',
    desc: 'Ongoing safety training and skills development for every worker, reinforced at every stage of yard operations.',
    icon: 'M12 2l7 3v6c0 5-3.4 8.7-7 10-3.6-1.3-7-5-7-10V5l7-3z M9 12l2 2 4-4',
  },
]
---

<section class="relative py-24 lg:py-36 overflow-hidden">
  <div class="hidden xl:block absolute inset-0 opacity-[0.035] pointer-events-none"
    style="background-image: linear-gradient(#0E2142 1px, transparent 1px), linear-gradient(90deg, #0E2142 1px, transparent 1px); background-size: 64px 64px;">
  </div>
  <div class="absolute -top-24 -right-24 w-[420px] h-[420px] rounded-full bg-sage-600/[0.05] blur-3xl pointer-events-none"></div>

  <div class="relative max-w-[1800px] mx-auto px-6 sm:px-10 xl:px-16 2xl:px-20">
    <div class="flex items-center gap-3 mb-4">
      <span class="w-8 h-px bg-rust-500"></span>
      <p class="eyebrow text-sage-600">Beyond the yard</p>
    </div>
    <h2 class="font-display font-semibold text-3xl lg:text-4xl xl:text-5xl text-navy-950 mb-16 lg:mb-24 max-w-2xl">
      Our Activities
    </h2>

    <div class="max-w-5xl border-t border-stone-300">
      {activities.map((a, i) => (
        <div class="group relative grid sm:grid-cols-[auto_1fr_auto] items-center gap-6 sm:gap-10 py-10 lg:py-12 border-b border-stone-300 transition-colors duration-300 hover:bg-white/60 px-3 -mx-3">

          <!-- oversized index numeral -->
          <span class="font-display font-bold text-6xl lg:text-7xl xl:text-8xl leading-none text-navy-950/[0.08] group-hover:text-rust-500/20 transition-colors duration-500 w-20 lg:w-24 shrink-0">
            {String(i + 1).padStart(2, '0')}
          </span>

          <div class="min-w-0">
            <div class="flex items-center gap-3 mb-3">
              <span class="flex items-center justify-center w-10 h-10 rounded-full border border-sage-600/30 bg-sage-600/[0.06] shrink-0 transition-colors duration-300 group-hover:border-rust-500/40 group-hover:bg-rust-500/[0.06]">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" class="text-sage-600 transition-colors duration-300 group-hover:text-rust-500">
                  <path d={a.icon} stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
              <span class="eyebrow text-stone-500">{a.tag}</span>
            </div>
            <h3 class="font-display font-semibold text-2xl lg:text-3xl text-navy-950 mb-2 transition-colors duration-300 group-hover:text-rust-600">
              {a.title}
            </h3>
            <p class="text-stone-600 text-sm leading-relaxed max-w-lg">{a.desc}</p>
          </div>

          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" class="hidden sm:block text-stone-300 shrink-0 transition-all duration-300 group-hover:text-rust-500 group-hover:translate-x-1">
            <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>

          <span class="absolute left-0 bottom-0 h-0.5 w-0 bg-rust-500 transition-all duration-300 ease-out group-hover:w-full"></span>
        </div>
      ))}
    </div>
  </div>
</section>