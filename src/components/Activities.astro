---
const activities = [
  { title: 'CSR', tag: 'Corporate Responsibility', img: '/img/activities/csr.jpg' },
  { title: 'Environmental Care', tag: 'Sustainability', img: '/img/activities/environmental-care.jpg' },
  { title: 'Cultural', tag: 'Community', img: '/img/activities/cultural.jpg' },
  { title: 'Training & Safety', tag: 'Workforce', img: '/img/activities/training-safety.jpg' },
]
---

<section class="relative py-24 lg:py-36 overflow-hidden">
  <div class="hidden xl:block absolute inset-0 opacity-[0.035] pointer-events-none"
    style="background-image: linear-gradient(#0E2142 1px, transparent 1px), linear-gradient(90deg, #0E2142 1px, transparent 1px); background-size: 64px 64px;">
  </div>

  <div class="relative max-w-[1800px] mx-auto px-6 sm:px-10 xl:px-16 2xl:px-20">
    <div class="flex items-center gap-3 mb-4">
      <span class="w-8 h-px bg-rust-500"></span>
      <p class="eyebrow text-sage-600">Beyond the yard</p>
    </div>
    <h2 class="font-display font-semibold text-3xl lg:text-4xl xl:text-5xl text-navy-950 mb-20 lg:mb-28">Our Activities</h2>

    <div class="grid sm:grid-cols-2 gap-8 xl:gap-12">
      {activities.map((a, i) => (
        <div class:list={['group', i % 2 === 1 && 'sm:mt-20 xl:mt-28']}>
          <div class="relative aspect-square overflow-hidden bg-stone-200">
            <img
              src={a.img}
              alt={a.title}
              class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
              loading="lazy"
            />

            <div class="absolute inset-0 bg-gradient-to-t from-navy-950/80 via-navy-950/10 to-transparent opacity-70 group-hover:opacity-90 transition-opacity duration-500"></div>

            <div class="absolute inset-0 flex flex-col justify-between p-7 xl:p-9">
              <div class="flex items-start justify-between">
                <span class="eyebrow text-white/90 bg-white/10 backdrop-blur-md border border-white/20 px-3 py-1.5">
                  {a.tag}
                </span>
                <span class="font-mono text-xs text-white/60">{String(i + 1).padStart(2, '0')}</span>
              </div>

              <div>
                <span class="block w-10 h-px bg-rust-500 mb-4 transition-all duration-500 group-hover:w-20"></span>
                <h3 class="font-display font-semibold text-3xl xl:text-4xl text-white leading-[1.05]">
                  {a.title}
                </h3>
              </div>
            </div>

            <span class="absolute inset-0 border border-transparent group-hover:border-rust-500/50 transition-colors duration-300"></span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>