<div class="relative bg-white border border-stone-200 p-6 sm:p-8 lg:p-10 shadow-[0_1px_2px_rgba(14,33,66,0.04),0_24px_48px_-20px_rgba(14,33,66,0.14)]">
  <div class="flex items-center gap-3 mb-2">
    <span class="w-8 h-px bg-rust-500 shrink-0"></span>
    <p class="eyebrow text-rust-500">Compose on WhatsApp</p>
  </div>
  <h3 class="font-display font-semibold text-2xl text-navy-950 mb-8">Send us a message</h3>

  <form id="contact-form" class="space-y-6">
    <div class="grid sm:grid-cols-2 gap-6">
      <div>
        <label for="name" class="block font-mono text-[11px] text-stone-500 mb-2">Full Name *</label>
        <div class="flex items-center border border-stone-300 bg-paper shadow-[inset_0_1px_2px_rgba(14,33,66,0.04)] focus-within:border-rust-500 focus-within:ring-2 focus-within:ring-rust-500/15 transition-all">
          <span class="flex items-center justify-center w-11 h-11 text-stone-400 shrink-0">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2M12 11a4 4 0 100-8 4 4 0 000 8z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
          <input type="text" id="name" name="name" required placeholder="Your name"
            class="w-full bg-transparent pr-4 py-3 text-sm text-navy-950 focus:outline-none min-w-0" />
        </div>
      </div>

      <div>
        <label for="email" class="block font-mono text-[11px] text-stone-500 mb-2">Email *</label>
        <div class="flex items-center border border-stone-300 bg-paper shadow-[inset_0_1px_2px_rgba(14,33,66,0.04)] focus-within:border-rust-500 focus-within:ring-2 focus-within:ring-rust-500/15 transition-all">
          <span class="flex items-center justify-center w-11 h-11 text-stone-400 shrink-0">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none"><path d="M4 4h16v16H4z M22 6l-10 7L2 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
          <input type="email" id="email" name="email" required placeholder="you@example.com"
            class="w-full bg-transparent pr-4 py-3 text-sm text-navy-950 focus:outline-none min-w-0" />
        </div>
      </div>
    </div>

    <div class="grid sm:grid-cols-2 gap-6">
      <div>
        <label for="phone" class="block font-mono text-[11px] text-stone-500 mb-2">Phone</label>
        <div class="flex items-center border border-stone-300 bg-paper shadow-[inset_0_1px_2px_rgba(14,33,66,0.04)] focus-within:border-rust-500 focus-within:ring-2 focus-within:ring-rust-500/15 transition-all">
          <span class="flex items-center justify-center w-11 h-11 text-stone-400 shrink-0">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none"><path d="M22 16.9v3a2 2 0 01-2.2 2 19.8 19.8 0 01-8.6-3.1 19.5 19.5 0 01-6-6A19.8 19.8 0 012.1 4.2 2 2 0 014.1 2h3a2 2 0 012 1.7c.1 1 .3 2 .6 2.9a2 2 0 01-.5 2.1L8 9.9a16 16 0 006 6l1.2-1.2a2 2 0 012.1-.5c.9.3 1.9.5 2.9.6a2 2 0 011.8 2z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
          <input type="tel" id="phone" name="phone" placeholder="Optional"
            class="w-full bg-transparent pr-4 py-3 text-sm text-navy-950 focus:outline-none min-w-0" />
        </div>
      </div>

      <div>
        <label for="subject" class="block font-mono text-[11px] text-stone-500 mb-2">Subject *</label>
        <div class="flex items-center border border-stone-300 bg-paper shadow-[inset_0_1px_2px_rgba(14,33,66,0.04)] focus-within:border-rust-500 focus-within:ring-2 focus-within:ring-rust-500/15 transition-all relative">
          <span class="flex items-center justify-center w-11 h-11 text-stone-400 shrink-0 pointer-events-none">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none"><path d="M9 12h6M9 16h6M9 8h2M5 4h14a1 1 0 011 1v14a1 1 0 01-1 1H5a1 1 0 01-1-1V5a1 1 0 011-1z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
          <select id="subject" name="subject" required
            class="w-full appearance-none bg-transparent pr-9 py-3 text-sm text-navy-950 focus:outline-none min-w-0">
            <option value="">Select an option</option>
            <option value="General Inquiry">General Inquiry</option>
            <option value="Ship Recycling Inquiry">Ship Recycling Inquiry</option>
            <option value="Investor Relations">Investor Relations</option>
            <option value="Media & Press">Media & Press</option>
            <option value="Careers">Careers</option>
          </select>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" class="absolute right-4 top-1/2 -translate-y-1/2 text-stone-400 pointer-events-none"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
      </div>
    </div>

    <div>
      <label for="message" class="block font-mono text-[11px] text-stone-500 mb-2">Message *</label>
      <textarea id="message" name="message" required rows="5" placeholder="How can we help?"
        class="w-full border border-stone-300 bg-paper px-4 py-3.5 text-sm text-navy-950 shadow-[inset_0_1px_2px_rgba(14,33,66,0.04)] focus:outline-none focus:border-rust-500 focus:ring-2 focus:ring-rust-500/15 transition-all resize-none"></textarea>
    </div>

    <div>
      <button type="submit" id="contact-submit-btn"
        class="flex items-center gap-2.5 bg-sage-600 text-white px-7 py-3.5 font-medium hover:bg-sage-600/90 transition-colors disabled:opacity-50 disabled:cursor-not-allowed shadow-[0_4px_12px_rgba(76,122,93,0.25)]">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none"><path d="M17.5 6.5a8 8 0 00-13 9.2L3 21l5.5-1.4a8 8 0 008-13.1z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Continue on WhatsApp
      </button>
      <p id="contact-disabled-note" class="mt-3 flex items-center gap-2 text-xs text-stone-500">
        <span class="eyebrow text-rust-500 bg-rust-500/10 border border-rust-500/25 px-2 py-0.5 rounded-full">provide</span>
        WhatsApp number pending from client — button will activate once added.
      </p>
    </div>
  </form>
</div>

<script>
  const WHATSAPP_NUMBER = '' // e.g. '919876543210' — set once client provides the number

  const form = document.getElementById('contact-form') as HTMLFormElement
  const btn = document.getElementById('contact-submit-btn') as HTMLButtonElement
  const note = document.getElementById('contact-disabled-note') as HTMLElement

  if (!WHATSAPP_NUMBER) {
    btn.disabled = true
  } else {
    note.classList.add('hidden')
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault()
    if (!WHATSAPP_NUMBER) return

    const data = new FormData(form)
    const lines = [
      `*New inquiry from website*`,
      `Name: ${data.get('name')}`,
      `Email: ${data.get('email')}`,
      data.get('phone') ? `Phone: ${data.get('phone')}` : null,
      `Subject: ${data.get('subject')}`,
      ``,
      `${data.get('message')}`,
    ].filter(Boolean).join('\n')

    const url = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(lines)}`
    window.open(url, '_blank', 'noopener')
  })
</script>