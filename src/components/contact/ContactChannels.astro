---
const channels = [
  {
    label: 'WhatsApp',
    desc: 'Fastest way to reach us for ship recycling inquiries.',
    href: null, // requires phone number — see note below
    cta: 'Chat on WhatsApp',
    icon: 'M17.5 6.5a8 8 0 00-13 9.2L3 21l5.5-1.4a8 8 0 008-13.1zM8 9.5c.3-1 1-1 1.4-.9.3.1.6.9.8 1.3.1.3 0 .5-.2.7l-.4.5c-.1.2-.1.4 0 .6.4.8 1.5 1.9 2.3 2.3.2.1.4.1.6 0l.5-.4c.2-.2.4-.3.7-.2.4.2 1.2.5 1.3.8.1.4.1 1.1-.9 1.4-1 .3-2.4-.1-4.2-1.9C8.1 11.9 7.7 10.5 8 9.5z',
    color: 'sage',
  },
  {
    label: 'Email',
    desc: 'For general inquiries, documentation, or formal correspondence.',
    href: 'mailto:works@rudragreenshiprecycling.com',
    cta: 'works@rudragreenshiprecycling.com',
    icon: 'M4 4h16v16H4z M22 6l-10 7L2 6',
    color: 'rust',
  },
  {
    label: 'Visit the Yard',
    desc: 'Alang, Bhavnagar, Gujarat — by prior appointment only.',
    href: null,
    cta: 'Get directions',
    icon: 'M12 22s8-4 8-11V5l-8-3-8 3v6c0 7 8 11 8 11z',
    color: 'navy',
  },
]

const colorMap = {
  sage: { ring: 'border-sage-600/40 bg-sage-600/10', icon: 'text-sage-600', hover: 'group-hover:border-sage-600/60' },
  rust: { ring: 'border-rust-500/40 bg-rust-500/10', icon: 'text-rust-500', hover: 'group-hover:border-rust-500/60' },
  navy: { ring: 'border-navy-900/25 bg-navy-900/5', icon: 'text-navy-800', hover: 'group-hover:border-navy-900/50' },
}
---

<section class="relative bg-paper py-4 lg:py-8 overflow-hidden">
  <div class="max-w-[1800px] mx-auto px-6 sm:px-10 xl:px-16 2xl:px-20">
    <div class="max-w-2xl mb-12 lg:mb-16">
      <p class="eyebrow text-sage-600 mb-5">Choose a channel</p>
      <h2 class="font-display font-semibold text-3xl lg:text-4xl text-navy-950 leading-[1.1]">
        Reach us the way that suits you.
      </h2>
    </div>

    <div class="grid sm:grid-cols-3 gap-5 xl:gap-6">
      {channels.map((c) => (
        <div class={`group relative bg-white border ${colorMap[c.color].ring.split(' ')[0]} p-7 xl:p-8 transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_1px_2px_rgba(14,33,66,0.04),0_20px_40px_-16px_rgba(14,33,66,0.16)] min-w-0`}>
          <span class={`flex items-center justify-center w-12 h-12 rounded-full border mb-6 ${colorMap[c.color].ring}`}>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" class={colorMap[c.color].icon}>
              <path d={c.icon} stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
          <h3 class="font-display font-semibold text-xl text-navy-950 mb-2">{c.label}</h3>
          <p class="text-stone-600 text-sm leading-relaxed mb-6">{c.desc}</p>

          {c.href ? (
            <a href={c.href} class="inline-flex items-center gap-2 text-sm font-medium text-navy-900 hover:text-rust-600 transition-colors break-all">
              {c.cta}
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" class="shrink-0"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          ) : c.label === 'WhatsApp' ? (
            <a href="#contact-form" class="inline-flex items-center gap-2 text-sm font-medium text-navy-900 hover:text-rust-600 transition-colors">
              Use the form below
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M12 5v14M19 12l-7 7-7-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          ) : (
            <span class="inline-flex items-center gap-2 text-sm font-medium text-navy-900">
              {c.cta}
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          )}
        </div>
      ))}
    </div>
  </div>
</section>